# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
.env
.claude/
.claude/

# Supabase CLI version cache (auto-updated, not source-of-truth)
supabase/.temp/

# Build artifacts
build.ipa
*.ipa
*.aab
*.apk

# Play Store service-account key — REAL secret, never commit (goes to EAS creds)
play-service-account.json
# NOTE: google-services.json (Android Firebase client config) is intentionally
# committed — it's embedded in every APK anyway (not a secret), and the CI
# `eas build --local` needs it in the checkout. Sending pushes still requires
# the FCM V1 service-account key, which lives in EAS credentials, not here.
