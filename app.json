{
  "expo": {
    "name": "InBetween",
    "slug": "inbetween-app",
    "scheme": "inbetween",
    "version": "1.8.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.loicviatte.inbetweenapp",
      "buildNumber": "1",
      "appleTeamId": "66DQR8326F",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "InBetween uses the microphone to let you dictate your class notes.",
        "UIBackgroundModes": [
          "audio"
        ],
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "package": "com.loicviatte.inbetweenapp",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/syne/400Regular/Syne_400Regular.ttf",
            "./node_modules/@expo-google-fonts/syne/500Medium/Syne_500Medium.ttf",
            "./node_modules/@expo-google-fonts/syne/600SemiBold/Syne_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/syne/700Bold/Syne_700Bold.ttf",
            "./node_modules/@expo-google-fonts/syne/800ExtraBold/Syne_800ExtraBold.ttf"
          ],
          "android": {
            "fonts": [
              { "fontFamily": "Syne-Regular", "fontDefinitions": [{ "path": "./node_modules/@expo-google-fonts/syne/400Regular/Syne_400Regular.ttf", "weight": 400 }] },
              { "fontFamily": "Syne-Medium", "fontDefinitions": [{ "path": "./node_modules/@expo-google-fonts/syne/500Medium/Syne_500Medium.ttf", "weight": 500 }] },
              { "fontFamily": "Syne-SemiBold", "fontDefinitions": [{ "path": "./node_modules/@expo-google-fonts/syne/600SemiBold/Syne_600SemiBold.ttf", "weight": 600 }] },
              { "fontFamily": "Syne-Bold", "fontDefinitions": [{ "path": "./node_modules/@expo-google-fonts/syne/700Bold/Syne_700Bold.ttf", "weight": 700 }] },
              { "fontFamily": "Syne-ExtraBold", "fontDefinitions": [{ "path": "./node_modules/@expo-google-fonts/syne/800ExtraBold/Syne_800ExtraBold.ttf", "weight": 800 }] }
            ]
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "InBetween uses the microphone to let you dictate your class notes."
        }
      ],
      "expo-video",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#000000",
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-asset",
      "@bacons/apple-targets",
      "./plugins/withGradleMemory.js",
      "./plugins/withPodsDeploymentTarget.js"
    ],
    "extra": {
      "eas": {
        "projectId": "e6845c91-600b-42a1-86ab-a74041006225"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e6845c91-600b-42a1-86ab-a74041006225"
    }
  }
}
