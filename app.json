{
  "expo": {
    "name": "InBetween",
    "slug": "inbetween-app",
    "version": "1.7.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.loicviatte.inbetweenapp",
      "buildNumber": "1",
      "appleTeamId": "66DQR8326F",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "InBetween uses the microphone to let you dictate your class notes.",
        "UIBackgroundModes": [
          "audio"
        ],
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/TTTravelsNext-Light.ttf",
            "./assets/fonts/TTTravelsNext-Regular.ttf",
            "./assets/fonts/TTTravelsNext-Medium.ttf",
            "./assets/fonts/TTTravelsNext-DemiBold.ttf",
            "./assets/fonts/TTTravelsNext-Bold.ttf",
            "./assets/fonts/TTTravelsNext-ExtraBold.ttf",
            "./node_modules/@expo-google-fonts/bricolage-grotesque/300Light/BricolageGrotesque_300Light.ttf",
            "./node_modules/@expo-google-fonts/bricolage-grotesque/400Regular/BricolageGrotesque_400Regular.ttf",
            "./node_modules/@expo-google-fonts/bricolage-grotesque/500Medium/BricolageGrotesque_500Medium.ttf"
          ],
          "android": {
            "fonts": [
              { "fontFamily": "TTTravelsNextTrl-Lt", "fontDefinitions": [{ "path": "./assets/fonts/TTTravelsNext-Light.ttf", "weight": 300 }] },
              { "fontFamily": "TTTravelsNextTrl-Rg", "fontDefinitions": [{ "path": "./assets/fonts/TTTravelsNext-Regular.ttf", "weight": 400 }] },
              { "fontFamily": "TTTravelsNextTrl-Md", "fontDefinitions": [{ "path": "./assets/fonts/TTTravelsNext-Medium.ttf", "weight": 500 }] },
              { "fontFamily": "TTTravelsNextTrl-DmBd", "fontDefinitions": [{ "path": "./assets/fonts/TTTravelsNext-DemiBold.ttf", "weight": 600 }] },
              { "fontFamily": "TTTravelsNextTrl-Bd", "fontDefinitions": [{ "path": "./assets/fonts/TTTravelsNext-Bold.ttf", "weight": 700 }] },
              { "fontFamily": "TTTravelsNextTrl-XBd", "fontDefinitions": [{ "path": "./assets/fonts/TTTravelsNext-ExtraBold.ttf", "weight": 800 }] },
              { "fontFamily": "BricolageGrotesque-Light", "fontDefinitions": [{ "path": "./node_modules/@expo-google-fonts/bricolage-grotesque/300Light/BricolageGrotesque_300Light.ttf", "weight": 300 }] },
              { "fontFamily": "BricolageGrotesque-Regular", "fontDefinitions": [{ "path": "./node_modules/@expo-google-fonts/bricolage-grotesque/400Regular/BricolageGrotesque_400Regular.ttf", "weight": 400 }] },
              { "fontFamily": "BricolageGrotesque-Medium", "fontDefinitions": [{ "path": "./node_modules/@expo-google-fonts/bricolage-grotesque/500Medium/BricolageGrotesque_500Medium.ttf", "weight": 500 }] }
            ]
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "InBetween uses the microphone to let you dictate your class notes."
        }
      ],
      "expo-video",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#000000",
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-asset",
      "@bacons/apple-targets"
    ],
    "extra": {
      "eas": {
        "projectId": "e6845c91-600b-42a1-86ab-a74041006225"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e6845c91-600b-42a1-86ab-a74041006225"
    }
  }
}
